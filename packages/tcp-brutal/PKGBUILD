pkgname=tcp-brutal
pkgver=2.0.1
pkgrel=2
pkgdesc="Hysteria's congestion control algorithm ported to TCP."
arch=(x86_64)
url=https://github.com/HyNetworks/tcp-brutal
makedepends=(linux-headers tcp-brutal-dkms=$pkgver)
license=(GPL-3.0-only)
options=('!strip' '!debug')
provides=(TCP-BRUTAL-MODULE=$pkgver)
conflicts=(TCP-BRUTAL-MODULE)

build() {
    _kernver=$(</usr/src/linux/version)
    fakeroot dkms build --dkmstree "${srcdir}" -m tcp-brutal/${pkgver} -k ${_kernver}
}

package() {
    depends=(linux)
    _kernver="$(</usr/src/linux/version)"

    install -Dt "${pkgdir}/usr/lib/modules/${_kernver}/extramodules" -m644 tcp-brutal/${pkgver}/${_kernver}/${CARCH}/module/*.ko

    # compress each module individually
    find "$pkgdir" -name '*.ko' -exec zstd --rm -19 {} +
}
