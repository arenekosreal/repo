_id=com.github.Anuken.Mindustry
_jdk_ver=25 # The newer cannot run gradle jar
# Check Arc/build.gradle
_soloud_ver=2026.09.04

pkgname=mindustry
pkgver=160.5
pkgrel=1
pkgdesc="The automation tower defense RTS"
arch=(any)
url=https://mindustrygame.github.io/
license=(GPL-3.0-or-later)
depends=("java-runtime>=$_jdk_ver" hicolor-icon-theme bash glew sdl2 freetype2)
makedepends=("java-environment=$_jdk_ver")
optdepends=('zenity: Run tinyfiledialog'
            'kdialog: Run tinyfiledialog')
source=("Mindustry-$pkgver.tar.gz::https://github.com/Anuken/Mindustry/archive/refs/tags/v$pkgver.tar.gz"
        "Arc-$pkgver.tar.gz::https://github.com/Anuken/Arc/archive/refs/tags/v$pkgver.tar.gz"
        "soloud-$_soloud_ver.tar.gz::https://github.com/Anuken/soloud/archive/refs/tags/$_soloud_ver.tar.gz"
        "https://raw.githubusercontent.com/nothings/stb/013ac3beddff3dbffafd5177e7972067cd2b5083/stb_image.h"
        "$_id.desktop"
        "0001-arc-use-system-freetype2.diff"
        "0002-arc-link-to-system-glew.diff")
sha256sums=('bab4d829613d0ee64283fc51aecd12ec49ac48943c0c32cbc0027487d7aadf48'
            '9228bda3cfdec72ccd300e852e52d0bda5f37270478d3f7b386d643e868c074e'
            'c1bc9c9015d926bd1da5826e7922a00d7d9c540c4c0ca7b5c7c36506a04d6290'
            '594c2fe35d49488b4382dbfaec8f98366defca819d916ac95becf3e75f4200b3'
            '2310804fba853c04ebe87228299dd18ae1219e7261b8230b8e39041cfce16436'
            'b9ec975576e5b936de688fae89f3b4d6bb6290d5c1e2e3381ac10e71e446e45c'
            'e7ba9c66baa621d41486d4f143580c2779632900d3b8cae746fb5a9355964911')

prepare() {
    ln -sr "Arc-$pkgver" Arc
    ln -sr "soloud-$_soloud_ver" Arc/arc-core/csrc/soloud 
    ln -sr "Mindustry-$pkgver" Mindustry
    ln -sr "stb_image.h" Arc/arc-core/csrc/stb_image.h
    # Remove prebuilt items
    rm -r Arc/natives/natives-*/libs/*
    rm -r Arc/backends/backend-*/libs/*
    rm -r Arc/arc-core/unsafe/unsafe.jar
    # Or they'll get downloaded
    mkdir -p Arc/backends/backend-sdl/build/jnigen/sources/
    touch Arc/backends/backend-sdl/build/jnigen/sources/{glew.zip,sdlmingw.tar.gz}
    # Remove unbuildable android backend
    sed -i 's/include ":backends:backend-android"//' \
        Arc/settings.gradle
    # It failed to launch on Wayland...
    sed -i 's/glewError != GLEW_OK/\0 \&\& glewError != GLEW_ERROR_NO_GLX_DISPLAY/' \
        Arc/backends/backend-sdl/src/arc/backend/sdl/jni/SDLGL.java
    patch -Np1 -d Arc -i "$srcdir/0001-arc-use-system-freetype2.diff"
    patch -Np1 -d Arc -i "$srcdir/0002-arc-link-to-system-glew.diff"
}

build() {
    # The last java runtime matches verson
    export JAVA_HOME="$(echo /usr/lib/jvm/java-$_jdk_ver-* | tail -1)"
    cd "$srcdir/Arc/arc-core/unsafe"
    "${JAVA_HOME}/bin/javac" --target 8 --source 8 -d . UnsafeBuffers.java
    "${JAVA_HOME}/bin/javac" --target 16 --source 16 -d . Java16Buffers.java
    "${JAVA_HOME}/bin/jar" cvf unsafe.jar arc
    rm -rf arc
    cd "$srcdir/Arc"
    ./gradlew preJni
    ./gradlew jnigenBuildLinux_$CARCH
    cp arc-core/build/natives/*/* natives/natives-desktop/libs/
    cp extensions/freetype/build/natives/*/* natives/natives-freetype-desktop/libs/
    cp extensions/filedialogs/build/natives/*/* natives/natives-filedialogs/libs/
    ./gradlew jnigenPackageAllDesktop
    cd "$srcdir/Mindustry"
    ./gradlew desktop:dist server:dist core:depsJar core:assetsJar core:mergedJavadoc \
        -Pbuildversion=$pkgver
}

package() {
    install -Dm644 -t "$pkgdir/usr/share/java/$pkgname" \
        "Mindustry/desktop/build/libs/Mindustry.jar" \
        "Mindustry/server/build/libs/server-release.jar"
    install -Dm644 "Mindustry/core/assets/icons/icon_64.png" \
        "$pkgdir/usr/share/icons/hicolor/64x64/apps/$_id.png"
    install -Dm644 "$_id.desktop" \
        "$pkgdir/usr/share/applications/$_id.desktop"
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<EOF
#!/usr/bin/bash

exec java -jar /usr/share/java/$pkgname/Mindustry.jar "\$@"
EOF
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname-server" <<EOF
#!/usr/bin/bash

exec java -jar /usr/share/java/$pkgname/server-release.jar "\$@"
EOF
}
